diff --git a/app/whimsy.css b/app/whimsy.css
new file mode 100644
index 0000000..1b45943
--- /dev/null
+++ b/app/whimsy.css
@@ -0,0 +1,1417 @@
+/* ==========================================================================
+   The Glow Arcade — a whimsical layer for the start.ng landing and sign-in.
+   It adds magic to the original cream / ink / lime theme; it does not
+   re-theme the site. Every rule is scoped under .whimsy.
+   ========================================================================== */
+
+.whimsy {
+  --w-display: var(--font-baloo), "Baloo 2", ui-rounded, "Trebuchet MS", system-ui, sans-serif;
+  --w-mint: #8ff0cf;
+  --w-gold: #ffd84d;
+  --w-leaf: #4f7a00;
+}
+
+/* ---------- a soft, sunlit band (the page itself stays cream) ---------- */
+.whimsy .whimsy-hero-band {
+  position: relative;
+  isolation: isolate;
+  overflow: hidden;
+  padding-bottom: 6px;
+  background:
+    radial-gradient(940px 470px at 50% -10%, color-mix(in srgb, var(--lime) 34%, transparent), transparent 72%),
+    radial-gradient(680px 400px at 10% 8%, color-mix(in srgb, var(--w-mint) 26%, transparent), transparent 70%),
+    radial-gradient(720px 430px at 92% 4%, color-mix(in srgb, var(--w-gold) 20%, transparent), transparent 72%);
+}
+
+:root[data-theme="dark"] .whimsy .whimsy-hero-band {
+  background:
+    radial-gradient(940px 470px at 50% -10%, rgba(216, 253, 113, 0.16), transparent 72%),
+    radial-gradient(680px 400px at 10% 8%, rgba(143, 240, 207, 0.12), transparent 70%),
+    radial-gradient(720px 430px at 92% 4%, rgba(255, 216, 77, 0.1), transparent 72%);
+}
+
+/* ---------- glowing orbs and tiny fireflies ---------- */
+.whimsy-sky {
+  position: absolute;
+  inset: 0;
+  z-index: -1;
+  overflow: hidden;
+  pointer-events: none;
+}
+
+.whimsy-orb {
+  position: absolute;
+  left: var(--orb-x);
+  top: var(--orb-y);
+  width: var(--orb-size);
+  height: var(--orb-size);
+  border-radius: 50%;
+  background: radial-gradient(circle at 30% 28%, #ffffff 0%, var(--orb-color) 46%, transparent 72%);
+  filter: blur(var(--orb-blur));
+  opacity: 0.62;
+  animation: whimsy-drift var(--orb-duration) ease-in-out infinite alternate;
+  animation-delay: var(--orb-delay);
+  will-change: transform;
+}
+
+:root[data-theme="dark"] .whimsy-orb {
+  mix-blend-mode: screen;
+  opacity: 0.5;
+}
+
+.whimsy-star {
+  position: absolute;
+  left: var(--star-x);
+  top: var(--star-y);
+  width: var(--star-size);
+  height: var(--star-size);
+  border-radius: 50%;
+  background: var(--lime-deep);
+  box-shadow: 0 0 6px color-mix(in srgb, var(--lime-deep) 80%, transparent);
+  opacity: 0.55;
+  animation: whimsy-twinkle 3.4s ease-in-out infinite alternate;

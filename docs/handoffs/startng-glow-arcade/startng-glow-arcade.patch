+}
+
+:root[data-theme="dark"] .whimsy .page-head h1::after,
+:root[data-theme="dark"] .whimsy .cat-hero h1::after,
+:root[data-theme="dark"] .whimsy .tourney-top h1::after,
+:root[data-theme="dark"] .whimsy .lb-page h1::after,
+:root[data-theme="dark"] .whimsy .profile-head h1::after,
+:root[data-theme="dark"] .whimsy .docs-content h1::after,
+:root[data-theme="dark"] .whimsy .game-info h1::after,
+:root[data-theme="dark"] .whimsy .about-page h1::after,
+:root[data-theme="dark"] .whimsy .creators-page h1::after {
+  color: var(--lime);
+}
+
+/* A sparkle lands on cards when you reach for them. */
+.whimsy .game::after,
+.whimsy .tag-tile::after {
+  content: "\2726";
+  position: absolute;
+  top: 10px;
+  right: 12px;
+  z-index: 3;
+  font-size: 0.95rem;
+  color: var(--lime-deep);
+  text-shadow: 0 0 10px rgba(185, 233, 74, 0.9);
+  opacity: 0;
+  transform: scale(0.6) rotate(0deg);
+  transition: opacity 0.18s ease, transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
+  pointer-events: none;
+}
+
+.whimsy .game:hover::after,
+.whimsy .tag-tile:hover::after {
+  opacity: 1;
+  transform: scale(1) rotate(20deg);
+}
+
+:root[data-theme="dark"] .whimsy .game::after,
+:root[data-theme="dark"] .whimsy .tag-tile::after {
+  color: var(--lime);
+}
+
+/* Browse controls become a glass card. */
+.whimsy .search-row {
+  background: color-mix(in srgb, var(--card) 84%, transparent);
+  border: 1px solid color-mix(in srgb, var(--lime-deep) 45%, var(--line));
+  border-radius: 18px;
+  padding: 12px 14px;
+  box-shadow: 0 16px 34px rgba(41, 42, 35, 0.08), 0 0 0 3px color-mix(in srgb, var(--lime) 10%, transparent);
+  -webkit-backdrop-filter: blur(12px) saturate(120%);
+  backdrop-filter: blur(12px) saturate(120%);
+}
+
+.whimsy .search-row .filter-bar {
+  margin-bottom: 0;
+}
+
+/* Docs sidebar and profile header pick up the glass. */
+.whimsy .docs-side {
+  background: color-mix(in srgb, var(--card) 84%, transparent);
+  border: 1px solid color-mix(in srgb, var(--lime-deep) 45%, var(--line));
+  border-radius: 18px;
+  padding: 16px;
+  box-shadow: 0 16px 34px rgba(41, 42, 35, 0.08), 0 0 0 3px color-mix(in srgb, var(--lime) 10%, transparent);
+  -webkit-backdrop-filter: blur(12px) saturate(120%);
+  backdrop-filter: blur(12px) saturate(120%);
+}
+
+.whimsy .profile-head {
+  background: color-mix(in srgb, var(--card) 88%, transparent);
+  border: 1px solid color-mix(in srgb, var(--lime-deep) 45%, var(--line));
+  border-radius: 18px;
+  padding: 18px 20px;
+  box-shadow: 0 16px 34px rgba(41, 42, 35, 0.08), 0 0 0 3px color-mix(in srgb, var(--lime) 10%, transparent);
+  -webkit-backdrop-filter: blur(12px) saturate(120%);
+  backdrop-filter: blur(12px) saturate(120%);
+}
+
+:root[data-theme="dark"] .whimsy .search-row,
+:root[data-theme="dark"] .whimsy .docs-side,
+:root[data-theme="dark"] .whimsy .profile-head {
+  background: color-mix(in srgb, var(--card) 82%, transparent);
+  box-shadow: 0 16px 34px rgba(0, 0, 0, 0.35), 0 0 0 3px rgba(216, 253, 113, 0.08);
+}
+
+@media (max-width: 760px) {
+  .whimsy .search-row {
+    padding: 10px 12px;
+  }
+
+  .whimsy .docs-side {
+    padding: 14px;
+  }
+}

+++ b/components/SiteSky.tsx
@@ -0,0 +1,12 @@
+'use client';
+
+import { usePathname } from 'next/navigation';
+import { WhimsyOrbs } from './WhimsyOrbs';
+
+/** The home and sign-in pages have their own richer sky; every other page
+ *  gets this lighter, site-wide one behind the cream layout. */
+export function SiteSky() {
+  const pathname = usePathname();
+  if (pathname === '/' || pathname === '/signin') return null;
+  return <WhimsyOrbs className="whimsy-site-sky" />;
+}
diff --git a/components/WhimsyLayer.tsx b/components/WhimsyLayer.tsx
new file mode 100644
index 0000000..e667627
--- /dev/null
+++ b/components/WhimsyLayer.tsx
@@ -0,0 +1,232 @@
+'use client';
+
+import { useEffect, useRef } from 'react';
+import { usePathname } from 'next/navigation';
+
+const SPARK_COLORS = ["#d8fd71", "#b9e94a", "#ffd84d", "#8ff0cf", "#fffef2"];
+
+/** Cards that lean toward the pointer across the whole site. */
+const TILT_SELECTOR = [
+  '[data-tilt]',
+  '.game',
+  '.tag-tile',
+  '.promo',
+  '.creator-banner',
+  '.tourney-panel',
+  '.board-card',
+  '.lb-you',
+  '.panel',
+  '.profile-row',
+  '.submit-card',
+  '.mini-modal',
+  '.email-box',
+].join(',');
+
+function spawnSpark(container: HTMLDivElement, x: number, y: number) {
+  if (container.childElementCount > 22) return;
+  const spark = document.createElement("span");
+  spark.className = "whimsy-trail-spark";
+  spark.style.setProperty("--spark-x", `${x}px`);
+  spark.style.setProperty("--spark-y", `${y}px`);
+  spark.style.setProperty("--spark-dx", `${(Math.random() - 0.5) * 26}px`);
+  spark.style.setProperty("--spark-dy", `${(Math.random() - 0.5) * 22 + 8}px`);
+  spark.style.setProperty("--spark-size", `${5 + Math.random() * 9}px`);
+  spark.style.setProperty("--spark-color", SPARK_COLORS[Math.floor(Math.random() * SPARK_COLORS.length)]);
+  spark.style.setProperty("--spark-spin", `${(Math.random() - 0.5) * 180}deg`);
+  container.appendChild(spark);
+  const remove = () => spark.remove();
+  spark.addEventListener("animationend", remove, { once: true });
+  window.setTimeout(remove, 900);
+}
+
+/**
+ * Site-wide whimsy: a lime-and-gold wand cursor with a spark trail, and a
+ * gentle pointer tilt on cards. Skipped on touch devices and for
+ * prefers-reduced-motion visitors.
+ */
+export function WhimsyLayer() {
+  const cursorRef = useRef<HTMLDivElement>(null);
+  const trailRef = useRef<HTMLDivElement>(null);
+  const pathname = usePathname();
+
+  useEffect(() => {
+    if (typeof window === "undefined") return;
+    if (!window.matchMedia("(pointer: fine)").matches) return;
+    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
+
+    const root = document.documentElement;
+    root.classList.add("has-whimsy-cursor");
+
+    const cursor = cursorRef.current;
+    const trail = trailRef.current;
+    let frame = 0;
+    let lastSpark = 0;
+    let targetX = window.innerWidth / 2;
+    let targetY = window.innerHeight / 2;
+    let x = targetX;
+    let y = targetY;
+    let visible = false;
+
+    const draw = () => {
+      x += (targetX - x) * 0.22;
+      y += (targetY - y) * 0.22;
+      if (cursor) cursor.style.transform = `translate3d(${x}px, ${y}px, 0)`;
+      frame = window.requestAnimationFrame(draw);
+    };
+
+    const onMove = (event: PointerEvent) => {
+      targetX = event.clientX;
+      targetY = event.clientY;
+      if (!visible) {
+        visible = true;
+        x = targetX;
+        y = targetY;
+        if (cursor) cursor.style.opacity = "1";
+      }
+      const now = performance.now();
+      if (trail && now - lastSpark > 65) {
+        lastSpark = now;
+        spawnSpark(trail, event.clientX, event.clientY);
+      }
+    };
+    const onLeave = () => {
+      if (cursor) cursor.style.opacity = "0";
+      visible = false;
+    };
+    const onDown = () => cursor?.classList.add("is-clicking");
+    const onUp = () => cursor?.classList.remove("is-clicking");
+
+    frame = window.requestAnimationFrame(draw);
+    window.addEventListener("pointermove", onMove, { passive: true });
+    document.addEventListener("pointerleave", onLeave);
+    window.addEventListener("pointerdown", onDown);
+    window.addEventListener("pointerup", onUp);
+
+    return () => {
+      root.classList.remove("has-whimsy-cursor");
+      window.cancelAnimationFrame(frame);
+      window.removeEventListener("pointermove", onMove);
+      document.removeEventListener("pointerleave", onLeave);
+      window.removeEventListener("pointerdown", onDown);
+      window.removeEventListener("pointerup", onUp);
+      if (trail) trail.replaceChildren();
+    };
+  }, []);
+
+  // Re-scan cards on every route change (and when new cards render).
+  useEffect(() => {
+    if (typeof window === "undefined") return;
+    if (!window.matchMedia("(pointer: fine)").matches) return;
+    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
+
+    let disposers: Array<() => void> = [];
+    let timer = 0;
+    let pending = false;
+
+    const setup = () => {
+      disposers.forEach((dispose) => dispose());
+      disposers = [];
+      const nodes = Array.from(document.querySelectorAll<HTMLElement>(TILT_SELECTOR)).slice(0, 90);
+      disposers = nodes.map((element) => {
+        let tiltFrame = 0;
+        let latest: PointerEvent | null = null;
+
+        const apply = () => {
+          tiltFrame = 0;
+          if (!latest) return;
+          const rect = element.getBoundingClientRect();
+          if (!rect.width || !rect.height) return;
+          const px = (latest.clientX - rect.left) / rect.width - 0.5;
+          const py = (latest.clientY - rect.top) / rect.height - 0.5;
+          element.style.setProperty("--tilt-x", `${(-py * 6).toFixed(2)}deg`);
+          element.style.setProperty("--tilt-y", `${(px * 8).toFixed(2)}deg`);
+          element.style.setProperty("--tilt-lift", "-3px");
+          element.classList.add("is-tilting");
+        };
+        const onTiltMove = (event: PointerEvent) => {
+          latest = event;
+          if (!tiltFrame) tiltFrame = window.requestAnimationFrame(apply);
+        };
+        const reset = () => {
+          latest = null;
+          element.style.removeProperty("--tilt-x");
+          element.style.removeProperty("--tilt-y");
+          element.style.removeProperty("--tilt-lift");
+          element.classList.remove("is-tilting");
+        };
+
+        element.addEventListener("pointermove", onTiltMove, { passive: true });
+        element.addEventListener("pointerleave", reset);
+        element.addEventListener("pointercancel", reset);
+        element.addEventListener("blur", reset);
+        return () => {
+          window.cancelAnimationFrame(tiltFrame);
+          element.removeEventListener("pointermove", onTiltMove);
+          element.removeEventListener("pointerleave", reset);
+          element.removeEventListener("pointercancel", reset);
+          element.removeEventListener("blur", reset);
+          reset();
+        };
+      });
+    };
+
+    // Do not let the cursor trail's own DOM churn keep resetting the scan.
+    const schedule = () => {
+      if (pending) return;
+      pending = true;
+      timer = window.setTimeout(() => {
+        pending = false;
+        setup();
+      }, 140);
+    };
+    schedule();
+    const observer = new MutationObserver((mutations) => {
+      for (const mutation of mutations) {
+        const target = mutation.target as Element;
+        if (target.closest?.(".whimsy-trail") || target.closest?.(".whimsy-cursor")) continue;
+        schedule();
+        break;
+      }
+    });
+    observer.observe(document.body, { childList: true, subtree: true });
+
+    return () => {
+      observer.disconnect();
+      window.clearTimeout(timer);
+      disposers.forEach((dispose) => dispose());
+    };
+  }, [pathname]);
+
+  return (
+    <>
+      <div ref={trailRef} className="whimsy-trail" aria-hidden="true" />
+      <div ref={cursorRef} className="whimsy-cursor" aria-hidden="true">
+        <svg viewBox="0 0 40 40" width="40" height="40" focusable="false">
+          <defs>
+            <radialGradient id="whimsy-cursor-glow" cx="50%" cy="50%" r="50%">
+              <stop offset="0%" stopColor="#fbffe0" stopOpacity=".95" />
+              <stop offset="55%" stopColor="#d8fd71" stopOpacity=".5" />
+              <stop offset="100%" stopColor="#8ff0cf" stopOpacity="0" />
+            </radialGradient>
+            <linearGradient id="whimsy-cursor-star" x1="0" y1="0" x2="1" y2="1">
+              <stop offset="0%" stopColor="#fffef2" />
+              <stop offset="45%" stopColor="#d8fd71" />
+              <stop offset="100%" stopColor="#8ff0cf" />
+            </linearGradient>
+          </defs>
+          <circle cx="20" cy="20" r="19" fill="url(#whimsy-cursor-glow)" />
+          <path
+            className="whimsy-cursor-star"
+            d="M20 4.5l3.4 9.9 10.1 3.4-10.1 3.4L20 31.1l-3.4-9.9L6.5 17.8l10.1-3.4z"
+            fill="url(#whimsy-cursor-star)"
+            stroke="#292a23"
+            strokeWidth="1.4"
+            strokeLinejoin="round"
+          />
+          <circle cx="31" cy="9" r="2" fill="#ffd84d" />
+          <circle cx="8" cy="29" r="1.5" fill="#b9e94a" />
+        </svg>
+      </div>
+    </>
+  );
+}
diff --git a/components/WhimsyOrbs.tsx b/components/WhimsyOrbs.tsx
new file mode 100644
index 0000000..52f8fa2
--- /dev/null
+++ b/components/WhimsyOrbs.tsx
@@ -0,0 +1,83 @@
+type Orb = {
+  size: number;
+  x: string;
+  y: string;
+  color: string;
+  duration: string;
+  delay: string;
+  blur: number;
+};
+
+const ORBS: Orb[] = [
+  { size: 150, x: "4%", y: "8%", color: "rgba(216, 253, 113, .6)", duration: "13s", delay: "-2s", blur: 2 },
+  { size: 90, x: "82%", y: "5%", color: "rgba(255, 216, 77, .55)", duration: "11s", delay: "-5s", blur: 1 },
+  { size: 220, x: "68%", y: "42%", color: "rgba(185, 233, 74, .3)", duration: "17s", delay: "-8s", blur: 6 },
+  { size: 60, x: "12%", y: "58%", color: "rgba(143, 240, 207, .6)", duration: "9s", delay: "-1s", blur: 0.5 },
+  { size: 34, x: "30%", y: "20%", color: "rgba(255, 255, 255, .9)", duration: "7s", delay: "-3s", blur: 0 },
+  { size: 110, x: "44%", y: "78%", color: "rgba(216, 253, 113, .35)", duration: "15s", delay: "-6s", blur: 3 },
+  { size: 70, x: "92%", y: "68%", color: "rgba(255, 216, 77, .45)", duration: "12s", delay: "-4s", blur: 1 },
+  { size: 26, x: "58%", y: "10%", color: "rgba(255, 255, 255, .85)", duration: "8s", delay: "-2.5s", blur: 0 },
+  { size: 46, x: "76%", y: "86%", color: "rgba(143, 240, 207, .55)", duration: "10s", delay: "-7s", blur: 0.5 },
+  { size: 20, x: "20%", y: "88%", color: "rgba(255, 232, 168, .85)", duration: "6s", delay: "-1.5s", blur: 0 },
+];
+
+const STARS = [
+  { x: "7%", y: "22%", size: 3, delay: "0s" },
+  { x: "18%", y: "10%", size: 2, delay: "-1.2s" },
+  { x: "26%", y: "44%", size: 2.5, delay: "-2.4s" },
+  { x: "36%", y: "14%", size: 2, delay: "-.6s" },
+  { x: "48%", y: "6%", size: 3, delay: "-3.1s" },
+  { x: "57%", y: "30%", size: 2, delay: "-1.8s" },
+  { x: "66%", y: "18%", size: 2.5, delay: "-4s" },
+  { x: "74%", y: "36%", size: 2, delay: "-2.1s" },
+  { x: "86%", y: "24%", size: 3, delay: "-.9s" },
+  { x: "94%", y: "46%", size: 2, delay: "-3.6s" },
+  { x: "10%", y: "72%", size: 2.5, delay: "-2.8s" },
+  { x: "22%", y: "66%", size: 2, delay: "-4.4s" },
+  { x: "32%", y: "92%", size: 2.5, delay: "-1.4s" },
+  { x: "44%", y: "56%", size: 2, delay: "-.4s" },
+  { x: "54%", y: "84%", size: 2, delay: "-3.3s" },
+  { x: "64%", y: "62%", size: 3, delay: "-2s" },
+  { x: "78%", y: "52%", size: 2, delay: "-4.8s" },
+  { x: "88%", y: "80%", size: 2.5, delay: "-1s" },
+  { x: "96%", y: "12%", size: 2, delay: "-2.6s" },
+  { x: "40%", y: "26%", size: 2, delay: "-5s" },
+];
+
+export function WhimsyOrbs({ className = "" }: { className?: string }) {
+  return (
+    <div className={`whimsy-sky ${className}`.trim()} aria-hidden="true">
+      {ORBS.map((orb, index) => (
+        <span
+          key={`orb-${index}`}
+          className="whimsy-orb"
+          style={
+            {
+              "--orb-size": `${orb.size}px`,
+              "--orb-x": orb.x,
+              "--orb-y": orb.y,
+              "--orb-color": orb.color,
+              "--orb-duration": orb.duration,
+              "--orb-delay": orb.delay,
+              "--orb-blur": `${orb.blur}px`,
+            } as React.CSSProperties
+          }
+        />
+      ))}
+      {STARS.map((star, index) => (
+        <span

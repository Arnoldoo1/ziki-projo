+    </span>
+  );
+}
+
+/** Bold outlined sparkle used for static and burst effects. */
+export function Sparkle({ size = 18, color = 'var(--wd-spark-1)', char = '✦' }: { size?: number; color?: string; char?: string }) {
+  return (

+
+@keyframes wd-btn-bounce {
+  0%, 100% { translate: 0 0; scale: 1; }
+  30% { translate: 0 -5px; scale: 1.04; }
+  60% { translate: 0 1px; scale: 0.99; }
+}
+
+@keyframes wd-squish {
+  0% { scale: 1; }
+  35% { scale: 0.94; }
+  70% { scale: 1.03; }
+  100% { scale: 1; }
+}
+
+@keyframes wd-spin {
+  to { transform: rotate(360deg); }
+}
+
+.wd-wave {
+  transform-box: view-box;
+  transform-origin: 76px 50px;
+  animation: wd-wave 2.4s ease-in-out infinite;
+}
+
+@keyframes wd-wave {
+  0%, 100% { transform: rotate(0deg); }
+  50% { transform: rotate(-16deg); }
+}
+
+/* ---------- reduced motion: keep decoration, drop animation ---------- */
+@media (prefers-reduced-motion: reduce) {
+  .wd-runner { display: none !important; }

+}
+
+/* ---------- motion ---------- */
+@keyframes wd-float {
+  0%, 100% { translate: 0 0; }
+  50% { translate: 0 -9px; }
+}
+
+@keyframes wd-bob {
+  0%, 100% { translate: 0 0; }

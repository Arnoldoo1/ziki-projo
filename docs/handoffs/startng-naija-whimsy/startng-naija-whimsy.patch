+  .wd-decor *::after,
+  [data-whimsy] .wd-squish,
+  [data-whimsy] .hero .actions .btn,
+  [data-whimsy] .hero .actions .ghost {
+    animation: none !important;
+    transition: none !important;
+  }
+
+  [data-whimsy] .game:hover,
+  [data-whimsy] .tag-tile:hover,
+  [data-whimsy] .promo:hover,
+  [data-whimsy] .tourney-panel:hover,
+  [data-whimsy] .panel:hover,
+  [data-whimsy] .board-card:hover,
+  [data-whimsy] .step:hover {
+    rotate: none;
+  }
+
+  [data-whimsy] .wd-reveal {
+    opacity: 1 !important;
+    transform: none !important;
+  }
+
+  [data-whimsy] .section-head::before,
+  [data-whimsy] .page-head::before,
+  [data-whimsy] .cat-hero::before,
+  [data-whimsy] .tourney-top::before,
+  [data-whimsy] .lb-page::before,
+  [data-whimsy] .profile-head::before,
+  [data-whimsy] .docs-content h1::before,
+  [data-whimsy] .about-page h1::before,
+  [data-whimsy] .game::after,
+  [data-whimsy] .tag-tile::after,
+  [data-whimsy] .promo::after,
+  [data-whimsy] .new-badge,
+  .wd-tourney-props *,
+  .wd-medal,
+  .wd-medal *,
+  .wd-signin-mascot,
+  .wd-signin-mascot *,
+  .wd-auth-mascot,
+  .wd-auth-mascot *,
+  .wd-wave {
+    animation: none !important;
+    transition: none !important;
+  }
+}
+
+/* Tablet widths: keep the corner sparkles inside the page padding. */
+@media (min-width: 761px) and (max-width: 1199px) {
+  .wd-fixed-spark { font-size: 15px !important; }
+  .wd-fixed-spark:nth-child(odd) { left: 0.5% !important; right: auto !important; }
+  .wd-fixed-spark:nth-child(even) { left: auto !important; right: 0.5% !important; }
+}

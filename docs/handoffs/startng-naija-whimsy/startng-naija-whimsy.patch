+  50% { rotate: 5deg; }
+  75% { rotate: -3deg; }
+}
+
+@keyframes wd-pop {
+  0% { opacity: 0; scale: 0.2; rotate: -40deg; }
+  60% { opacity: 1; scale: 1.25; }
+  100% { opacity: 1; scale: 1; rotate: 0deg; }

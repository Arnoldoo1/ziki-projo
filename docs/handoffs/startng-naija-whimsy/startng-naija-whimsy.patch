+  --wd-outline: #f6f5ee;
+  --wd-lime: #d8fd71;
+  --wd-lime-deep: #d8fd71;
+  --wd-gold: #ffd84d;
+  --wd-yellow: #ffd84d;
+  --wd-orange: #ffb347;
+  --wd-red: #ff8a7d;
+  --wd-green: #7fd884;
+  --wd-brown: #e0a66b;
+  --wd-pink: #ff9db0;
+  --wd-teal: #5ee7ff;
+  --wd-spark-1: #d8fd71;

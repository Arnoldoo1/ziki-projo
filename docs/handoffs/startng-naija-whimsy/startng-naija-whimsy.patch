+  --wd-outline: #292a23;
+  --wd-lime: #b9e94a;
+  --wd-lime-deep: #4f7a00;
+  --wd-gold: #c98a00;
+  --wd-yellow: #e0a800;
+  --wd-orange: #c25e00;
+  --wd-red: #b02a1e;
+  --wd-green: #2e7d32;
+  --wd-brown: #7a3e12;
+  --wd-pink: #b03060;
+  --wd-teal: #0f6b63;
+  --wd-spark-1: #4f7a00;
+  --wd-spark-2: #a86a00;
+  --wd-spark-3: #b02a1e;
+  --wd-spark-4: #0f6b63;
